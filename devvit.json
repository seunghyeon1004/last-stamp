{
  "$schema": "https://developers.reddit.com/schema/config-file.v1.json",
  "name": "overprint-press",
  "post": {
    "dir": "dist/client",
    "entrypoints": {
      "default": {
        "styles": {
          "backgroundColor": "#F2EDE4FF",
          "backgroundColorDark": "#F2EDE4FF"
        },
        "entry": "splash.html",
        "height": "tall"
      },
      "game": {
        "entry": "game.html"
      }
    }
  },
  "server": {
    "dir": "dist/server",
    "entry": "index.cjs"
  },
  "permissions": {
    "redis": true,
    "reddit": {
      "enable": true,
      "asUser": [
        "SUBMIT_COMMENT"
      ]
    },
    "journeys": true
  },
  "menu": {
    "items": [
      {
        "label": "Post today's Overprint",
        "description": "Create today's daily print post (once per day)",
        "location": "subreddit",
        "forUserType": "moderator",
        "endpoint": "/internal/menu/post-today"
      }
    ]
  },
  "triggers": {
    "onAppInstall": "/internal/triggers/on-app-install",
    "onPostDelete": "/internal/triggers/on-post-delete",
    "onCommentDelete": "/internal/triggers/on-comment-delete"
  },
  "scheduler": {
    "tasks": {
      "daily-post": {
        "endpoint": "/internal/scheduler/daily-post",
        "cron": "2 0 * * *"
      }
    }
  },
  "scripts": {
    "dev": "vite build --watch",
    "build": "vite build"
  },
  "dev": {
    "subreddit": "overprint_press_dev"
  }
}
